    {
      "parameters": {
        "jsCode": "// Prepare data for video assembly\nconst videoId = $('Setup Configuration').item.json.video_id;\nconst mediaList = $('Fetch Media via Laravel').item.json.media_list || [];\n\n// Create assembly data\nconst assemblyData = {\n  video_id: videoId,\n  media_list: mediaList,\n  voiceover_path: `/tmp/voiceover_${videoId}.mp3`\n};\n\nreturn {\n  json: {\n    assembly_data: JSON.stringify(assemblyData),\n    video_id: videoId\n  }\n};"
      },
      "id": "prepare-assembly",
      "name": "Prepare Video Assembly Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 300]
    },
    {
      "parameters": {
        "command": "python3",
        "parameters": "/app/scripts/create_video.py '{{ $json.assembly_data }}'"
      },
