        "responseBody": "={{ \n  $('Check YouTube Auth').item.json && $('Upload to YouTube') ? \n  {\n    \"success\": true,\n    \"message\": \"Video generated and uploaded to YouTube successfully!\",\n    \"video_id\": $('Setup Configuration').item.json.video_id,\n    \"youtube_url\": \"https://www.youtube.com/watch?v=\" + $('Upload to YouTube').item.json.id,\n    \"local_path\": \"/tmp/final_video_\" + $('Setup Configuration').item.json.video_id + \".mp4\"\n  } : \n  {\n    \"success\": true,\n    \"message\": \"Video generated successfully! (No YouTube upload - missing auth)\",\n    \"video_id\": $('Setup Configuration').item.json.video_id,\n    \"local_path\": \"/tmp/final_video_\" + $('Setup Configuration').item.json.video_id + \".mp4\",\n    \"note\": \"Provide youtube_access_token to enable YouTube upload\"\n  }\n}}"
