      "webhookId": "complete-video-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Setup workflow data - NO API keys stored here!\nreturn {\n  json: {\n    // Input data from webhook\n    topic: $input.item.json.topic || 'Technology Trends',\n    duration: $input.item.json.duration || 5,\n    user_id: $input.item.json.user_id,\n    video_id: $input.item.json.video_id || Date.now().toString(),\n    \n    // Laravel API token for authentication\n    api_token: $input.item.json.api_token || \"default-token\",\n    \n    // Laravel base URL\n    laravel_url: \"http://app:8000\"\n  }\n};"
      },
